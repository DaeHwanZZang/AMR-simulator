{
  "_설명": [
    "런처(tools/launcher.py)가 관리할 툴 목록. 새 툴은 여기에 항목만 추가하면 붙는다.",
    "mode: single(하나, 목록에 항상 있음) / per_map(맵마다 하나) / multi(여러 개, 폼으로 추가) / oneshot(한 번 실행하고 끝남)",
    "cmd: 문자열 또는 {\"if\": 키, \"args\": [...]} (키 값이 참일 때만 args 포함). {키} 는 폼 값/공통 값으로 치환.",
    "공통 값: {python}(런처 인터프리터) {repo}(리포 루트) {host} {port} {map}(fms_map.json 절대경로, 맵 없음이면 빈 문자열)",
    "cwd: 리포 루트 기준 상대경로. requires: [\"broker\"]. needs_map: 맵 필수. needs_build: 없으면 make 를 권하는 바이너리.",
    "stop_timeout_s: SIGTERM 후 기다리는 시간. 넘으면 강제 종료할지 묻는다.",
    "listens: 브로커 항목 전용(브로커 포트). 런처가 이 키가 있는 항목을 브로커로 다룬다. 웹 서버 포트에는 쓰지 않는다.",
    "env: {이름: 값} 환경변수. 값도 {키} 치환한다 (설정을 환경변수로만 받는 툴용, 예: fms_server).",
    "params: type = str / int / float / bool / choice(choices), group 이 바뀌면 폼에 구분 제목이 들어간다.",
    "multi: id_param(이름으로 쓸 키), id_fmt(자동 이름), step({키: 대수마다 더할 값})"
  ],
  "tools": [
    {
      "id": "broker",
      "name": "브로커 (mosquitto)",
      "mode": "single",
      "cmd": ["mosquitto", "-c", "broker/mosquitto.conf", "-v"],
      "listens": 1883,
      "stop_timeout_s": 5
    },
    {
      "id": "robot",
      "name": "로봇 클라이언트",
      "mode": "multi",
      "cmd": [
        "build/bin/robot_client", "--id", "{id}", "--host", "{host}", "--port", "{port}",
        "--x", "{x}", "--y", "{y}", "--theta", "{theta}",
        {"if": "map", "args": ["--map", "{map}"]},
        "--robot-width", "{robot_width}", "--robot-length", "{robot_length}",
        "--max-velocity", "{max_velocity}", "--max-acceleration", "{max_acceleration}",
        "--battery", "{battery}", "--battery-low", "{battery_low}", "--battery-critical", "{battery_critical}", "--speed-noise", "{speed_noise}",
        "--sensor-range", "{sensor_range}", "--log-level", "{log_level}",
        "--friction", "{friction}", "--mass", "{mass}",
        "--loc-rate", "{loc_rate}", "--loc-noise-xy", "{loc_noise_xy}", "--loc-noise-theta", "{loc_noise_theta}",
        "--loc-gain", "{loc_gain}", "--loc-dropout", "{loc_dropout}",
        {"if": "seed", "args": ["--seed", "{seed}"]},
        {"if": "map_cache", "args": ["--map-cache", "{map_cache}"]},
        {"if": "record", "args": ["--record", "{record}"]},
        {"if": "gui", "args": ["--gui"]},
        {"if": "path_refine", "args": ["--path-refine"]},
        {"if": "obstacle_zone", "args": [
          "--obstacle-zone", "{obstacle_zone}",
          "--obstacle-spawn-interval", "{obstacle_spawn_interval}",
          "--obstacle-max-count", "{obstacle_max_count}",
          "--obstacle-width", "{obstacle_width}", "--obstacle-height", "{obstacle_height}",
          "--obstacle-speed", "{obstacle_speed}"]},
        {"if": "obstacle_sides", "args": ["--obstacle-sides", "{obstacle_sides}"]},
        {"if": "obstacle_seed", "args": ["--obstacle-seed", "{obstacle_seed}"]}
      ],
      "requires": ["broker"],
      "needs_build": "build/bin/robot_client",
      "stop_timeout_s": 5,
      "multi": {"id_param": "id", "id_fmt": "AMR-{n:03d}", "step": {"y": 1.0}},
      "params": [
        {"key": "id", "label": "로봇 ID", "type": "str", "default": "AMR-001"},
        {"key": "x", "label": "시작 x (m)", "type": "float", "default": 0.0},
        {"key": "y", "label": "시작 y (m)", "type": "float", "default": 0.0},
        {"key": "theta", "label": "시작 theta (rad)", "type": "float", "default": 0.0},
        {"key": "gui", "label": "제어판(GUI) 창", "type": "bool", "default": false},
        {"key": "path_refine", "label": "PSO 경로 다듬기", "type": "bool", "default": false},
        {"group": "물리", "key": "robot_width", "label": "로봇 폭 (m)", "type": "float", "default": 0.5},
        {"group": "물리", "key": "robot_length", "label": "로봇 길이 (m)", "type": "float", "default": 0.7},
        {"group": "물리", "key": "max_velocity", "label": "최대 속도 (m/s)", "type": "float", "default": 1.2},
        {"group": "물리", "key": "max_acceleration", "label": "최대 가속도 (m/s²)", "type": "float", "default": 0.6},
        {"group": "물리", "key": "battery", "label": "시작 배터리 (%)", "type": "float", "default": 100.0},
        {"group": "물리", "key": "battery_low", "label": "배터리 낮음 경고 (%)", "type": "float", "default": 20.0},
        {"group": "물리", "key": "battery_critical", "label": "배터리 위험 (%, 아래면 DOCK 오더만)", "type": "float", "default": 5.0},
        {"group": "물리", "key": "speed_noise", "label": "속도 노이즈 비율", "type": "float", "default": 0.05},
        {"group": "물리", "key": "friction", "label": "바퀴-바닥 마찰계수 μ (낮으면 슬립)", "type": "float", "default": 0.8},
        {"group": "물리", "key": "mass", "label": "로봇 질량 (kg)", "type": "float", "default": 60.0},
        {"group": "위치추정", "key": "loc_rate", "label": "라이다 위치보정 주기 (Hz, 0=보정 없음)", "type": "float", "default": 5.0},
        {"group": "위치추정", "key": "loc_noise_xy", "label": "측정 노이즈 위치 (m)", "type": "float", "default": 0.02},
        {"group": "위치추정", "key": "loc_noise_theta", "label": "측정 노이즈 방위 (rad)", "type": "float", "default": 0.01},
        {"group": "위치추정", "key": "loc_gain", "label": "보정 게인 (0~1)", "type": "float", "default": 0.15},
        {"group": "위치추정", "key": "loc_dropout", "label": "측정 누락 확률 (0~1)", "type": "float", "default": 0.05},
        {"group": "실험/FMS", "key": "seed", "label": "난수 시드 (비우면 로봇 ID 기반)", "type": "str", "default": ""},
        {"group": "실험/FMS", "key": "map_cache", "label": "SET_MAP 맵 캐시 폴더 (비우면 map_cache)", "type": "str", "default": ""},
        {"group": "물리", "key": "record", "label": "데이터 기록 폴더 (비우면 꺼짐)", "type": "str", "default": ""},
        {"group": "물리", "key": "sensor_range", "label": "장애물 감지 반경 (m)", "type": "float", "default": 3.0},
        {"group": "물리", "key": "log_level", "label": "로그 레벨", "type": "choice", "choices": ["DEBUG", "INFO", "WARNING"], "default": "INFO"},
        {"group": "동적 장애물 (구역을 비우면 꺼짐)", "key": "obstacle_zone", "label": "구역 XMIN,YMIN,XMAX,YMAX", "type": "str", "default": ""},
        {"group": "동적 장애물 (구역을 비우면 꺼짐)", "key": "obstacle_sides", "label": "진입-이탈 면 (예 4-2, 빈값=랜덤)", "type": "str", "default": ""},
        {"group": "동적 장애물 (구역을 비우면 꺼짐)", "key": "obstacle_spawn_interval", "label": "스폰 주기 (초)", "type": "float", "default": 5.0},
        {"group": "동적 장애물 (구역을 비우면 꺼짐)", "key": "obstacle_max_count", "label": "동시 최대 개수", "type": "int", "default": 3},
        {"group": "동적 장애물 (구역을 비우면 꺼짐)", "key": "obstacle_width", "label": "가로 (m)", "type": "float", "default": 0.4},
        {"group": "동적 장애물 (구역을 비우면 꺼짐)", "key": "obstacle_height", "label": "세로 (m)", "type": "float", "default": 0.4},
        {"group": "동적 장애물 (구역을 비우면 꺼짐)", "key": "obstacle_speed", "label": "속도 (m/s)", "type": "float", "default": 0.5},
        {"group": "동적 장애물 (구역을 비우면 꺼짐)", "key": "obstacle_seed", "label": "장애물 시드 (비우면 로봇 ID 기반)", "type": "str", "default": ""}
      ]
    },
    {
      "id": "viewer",
      "name": "뷰어",
      "mode": "single",
      "cmd": [
        "{python}", "tools/fleet_monitor_qt.py", "--host", "{host}", "--port", "{port}",
        {"if": "follow", "args": ["--follow", "{follow}"]},
        {"if": "map", "args": ["--fallback-map", "{map}"]},
        "--fms", "{fms}",
        {"if": "no_orders", "args": ["--no-orders"]}
      ],
      "cwd": "viewer",
      "requires": ["broker"],
      "stop_timeout_s": 5,
      "params": [
        {"key": "follow", "label": "따라갈 로봇 (비우면 맵을 보고하는 첫 로봇)", "type": "str", "default": ""},
        {"key": "fms", "label": "맵 받을 FMS 주소", "type": "str", "default": "http://localhost:8000"},
        {"key": "no_orders", "label": "order 토픽 구독 안 함", "type": "bool", "default": false}
      ]
    },
    {
      "id": "map_editor",
      "name": "맵 편집기",
      "mode": "per_map",
      "cmd": ["{python}", "tools/map_editor.py", "{map}"],
      "needs_map": true,
      "stop_timeout_s": 30
    },
    {
      "id": "map_gen",
      "name": "맵 생성기",
      "mode": "single",
      "cmd": ["{python}", "tools/map_gen_gui.py"],
      "stop_timeout_s": 10
    },
    {
      "id": "setup_mujoco",
      "name": "MuJoCo 설치 (최초 1회)",
      "mode": "oneshot",
      "cmd": ["robot/tools/setup_mujoco.sh"],
      "stop_timeout_s": 10
    },
    {
      "id": "physics_test",
      "name": "물리 회귀 테스트",
      "mode": "oneshot",
      "cmd": ["{python}", "robot/tests/physics_test.py", {"if": "scenarios", "args": ["{scenarios}"]}],
      "stop_timeout_s": 15,
      "params": [
        {"key": "scenarios", "label": "시나리오 이름 1개 (비우면 전체)", "type": "str", "default": ""}
      ]
    },
    {
      "id": "instant",
      "name": "즉시명령 (send_order)",
      "mode": "oneshot",
      "cmd": ["build/bin/send_order", "{id}", "--host", "{host}", "--port", "{port}", "--instant", "{kind}"],
      "needs_build": "build/bin/send_order",
      "stop_timeout_s": 5,
      "params": [
        {"key": "id", "label": "로봇 ID", "type": "str", "default": "AMR-001"},
        {"key": "kind", "label": "종류", "type": "choice", "choices": ["PAUSE", "RESUME", "CANCEL_ORDER", "RESET_ERROR"], "default": "PAUSE"}
      ]
    },
    {
      "id": "run_script",
      "name": "스크립트 실행 (send_order --script)",
      "mode": "oneshot",
      "cmd": ["build/bin/send_order", "{id}", "--host", "{host}", "--port", "{port}", "--script", "{script}"],
      "needs_build": "build/bin/send_order",
      "stop_timeout_s": 5,
      "params": [
        {"key": "id", "label": "로봇 ID", "type": "str", "default": "AMR-001"},
        {"key": "script", "label": "스크립트 파일 (리포 루트 기준)", "type": "str", "default": "scripts/examples/demo_job.txt"}
      ]
    },
    {
      "id": "make",
      "name": "빌드 (make -C robot)",
      "mode": "oneshot",
      "cmd": ["make", "-C", "robot"],
      "stop_timeout_s": 10
    }
  ]
}
